:3000 {
  root * /srv

  @hashedAssets {
    path_regexp hashedAssets ^/assets/.+-[A-Za-z0-9_-]+\.(css|js|map|svg|png|jpe?g|webp|woff2?)$
    file
  }
  header @hashedAssets Cache-Control "public, max-age=31536000, immutable"
  header /audio/* Cache-Control "public, max-age=604800"
  @documents path / /index.html
  header @documents Cache-Control "no-cache"

  try_files {path} /index.html
  file_server
}
