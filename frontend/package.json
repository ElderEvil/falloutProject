{
  "name": "frontend",
  "version": "2.136.0",
  "private": true,
  "type": "module",
  "scripts": {
    "types:generate": "openapi-typescript http://localhost:8000/api/v1/openapi.json -o src/core/types/api.generated.ts",
    "dev": "pnpm types:generate && vp dev",
    "build": "vp build",
    "analyze": "vp build --mode analyze",
    "preview": "vp preview",
    "test": "vp test",
    "test:run": "vp test run",
    "test:coverage": "vp test run --coverage",
    "lint": "vp lint src",
    "lint:fix": "vp lint src --fix",
    "format": "vp fmt src",
    "format:check": "vp fmt src --check",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "e2e": "playwright install chromium && playwright test",
    "e2e:ui": "playwright install chromium && playwright test --ui",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@iconify/vue": "5.0.1",
    "@lucide/vue": "1.46.0",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "14.4.0",
    "axios": "1.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "3.4.15",
    "jwt-decode": "4.0.0",
    "pinia": "^4.0.3",
    "reka-ui": "2.10.4",
    "tailwind-merge": "3.7.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node22": "^22.0.6",
    "@types/jsdom": "28.0.3",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^29.1.1",
    "openapi-typescript": "7.13.0",
    "rollup-plugin-visualizer": "7.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.2.2",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11.0.0 <12"
  },
  "packageManager": "pnpm@11.9.0"
}
