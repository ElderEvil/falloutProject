2026-08-22 13:47:11 [INFO] [sqlalchemy.engine.Engine] [req:0909eb8e-bdb7-4e5f-ac26-80ba2ad599e6] SELECT incident.created_at, incident.updated_at, incident.type, incident.status, incident.difficulty, incident.start_time, incident.end_time, incident.duration, incident.damage_dealt, incident.enemies_defeated, incident.loot, incident.rooms_affected, incident.spread_count, incident.id, incident.vault_id, incident.room_id
FROM incident
WHERE incident.vault_id = $1::UUID AND incident.status IN ($2::incidentstatus, $3::incidentstatus)
