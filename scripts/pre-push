#!/bin/sh
# Inspect every destination supplied by Git, including force pushes and deletions.
while read -r local_ref local_oid remote_ref remote_oid
do
    case "$remote_ref" in
        refs/heads/master)
            printf '%s\n' 'Push blocked: direct updates to master require a pull request.' >&2
            printf '%s\n' 'Push your work to an explicit feature branch and open a PR.' >&2
            exit 1
            ;;
    esac
done
