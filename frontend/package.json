{
  "name": "frontend",
  "version": "3.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:serve": "vp dev --mode desktop-dev --host 127.0.0.1 --port 5173 --strictPort",
    "desktop:bundle": "vp build --mode desktop",
    "types:generate": "openapi-typescript http://localhost:8000/api/v1/openapi.json -o src/core/types/api.generated.ts",
    "dev": "pnpm types:generate && vp dev",
    "build": "vp build",
    "analyze": "vp build --mode analyze",
    "preview": "vp preview",
    "test": "vp test",
    "test:run": "vp test run",
    "test:coverage": "vp test run --coverage",
    "lint": "vp lint src --import-plugin --promise-plugin",
    "lint:fix": "vp lint src --import-plugin --promise-plugin --fix",
    "format": "vp fmt src",
    "format:check": "vp fmt src --check",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "e2e": "playwright install chromium && playwright test",
    "e2e:a11y": "PW_SKIP_BACKEND=1 playwright test tests/e2e/accessibility.spec.ts",
    "e2e:ui": "playwright install chromium && playwright test --ui",
    "e2e:install": "playwright install chromium",
    "perf:ui:check": "vp lint playwright.perf.config.ts tests/performance scripts/run-ui-performance.mjs scripts/summarize-ui-performance.mjs && tsc --noEmit -p tsconfig.perf.json",
    "perf:ui": "pnpm run perf:ui:check && pnpm run build && node scripts/run-ui-performance.mjs"
  },
  "dependencies": {
    "@iconify/vue": "5.0.5",
    "@lucide/vue": "1.69.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-notification": "2.8.0",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "15.0.0",
    "axios": "1.21.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "3.4.17",
    "jwt-decode": "4.0.0",
    "pinia": "^4.1.0",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "2.12.4",
    "@tsconfig/node22": "^22.0.6",
    "@types/jsdom": "30.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "@vue/compiler-dom": "^3.5.45",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.1.3",
    "openapi-typescript": "7.13.0",
    "rollup-plugin-visualizer": "7.1.2",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "1.4.0",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11.0.0 <12"
  },
  "packageManager": "pnpm@11.9.0"
}
