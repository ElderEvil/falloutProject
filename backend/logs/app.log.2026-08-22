2026-08-22 17:44:04 [INFO] [sqlalchemy.engine.Engine] [req:c6e4f1fd-06ea-45ef-ada0-472d53b981d7] SELECT vault.is_deleted, vault.deleted_at, vault.created_at, vault.updated_at, vault.number, vault.bottle_caps, vault.happiness, vault.power, vault.power_max, vault.food, vault.food_max, vault.water, vault.water_max, vault.population_max, vault.radio_mode, vault.id, vault.user_id, count(DISTINCT room.id) AS room_count, count(DISTINCT dweller.id) AS dweller_count, coalesce(max(storage.stimpack), $1::INTEGER) AS stimpack, coalesce(max(storage.radaway), $2::INTEGER) AS radaway
