# Root .dockerignore for monorepo builds with context: .
# Backend Dockerfile builds at repo root and copies:
#   - backend/ → /app/
#   - CHANGELOG.md → /CHANGELOG.md

# Git
.git/
.gitignore
.gitattributes

# Frontend, deployment and local-agent files are not used by the backend image.
frontend/
deployment/
.zed/
.agents/
.omo/

# Backend exclusions
backend/**/__pycache__/
backend/**/.ruff_cache/
backend/**/*.py[cod]
backend/**/*$py.class
backend/app.egg-info/
backend/.mypy_cache/
backend/.pytest_cache/
backend/.coverage
backend/coverage.json
backend/coverage.xml
backend/coverage-badge.json
backend/htmlcov/
backend/logs/
backend/.venv/
backend/venv/
backend/env/
backend/build/
backend/dist/
backend/*.egg-info/
backend/**/tests/
backend/**/test_*.py
backend/**/*_test.py
backend/**/conftest.py
backend/*.db
backend/*.sqlite3
backend/*.tmp
backend/*.temp
backend/*.log

# Documentation (except CHANGELOG.md which we explicitly COPY)
*.md
!CHANGELOG.md
docs/

# Development tools
.vscode/
.idea/
.DS_Store
*.log

# Environment files
**/.env
**/.env.*

# CI/CD
.github/
.gitlab-ci.yml

# Docker
docker-compose*.yml
Dockerfile*
!backend/Dockerfile
!frontend/Dockerfile

# Temporary files
*.tmp
*.temp
*.swp
*~
