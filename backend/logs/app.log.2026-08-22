2026-08-22 18:26:02 [INFO] [sqlalchemy.engine.Engine] [req:87aeebd8-aaf0-4437-9b4a-19f63388bdce] SELECT "user".is_deleted, "user".deleted_at, "user".created_at, "user".updated_at, "user".username, "user".email, "user".is_active, "user".is_superuser, "user".email_verified, "user".email_verification_token, "user".password_reset_token, "user".password_reset_expires, "user".id, "user".hashed_password, "user".monthly_token_limit
FROM "user"
WHERE "user".id = $1::UUID AND NOT "user".is_deleted
