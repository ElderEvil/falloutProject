2026-08-22 13:49:22 [INFO] [sqlalchemy.engine.Engine] [req:a34f7d2c-e89f-4402-b2d6-691f2ae6f971] SELECT vault.is_deleted, vault.deleted_at, vault.created_at, vault.updated_at, vault.number, vault.bottle_caps, vault.happiness, vault.power, vault.power_max, vault.food, vault.food_max, vault.water, vault.water_max, vault.population_max, vault.radio_mode, vault.id, vault.user_id, count(DISTINCT room.id) AS room_count, count(DISTINCT dweller.id) AS dweller_count, coalesce(max(storage.stimpack), $1::INTEGER) AS stimpack, coalesce(max(storage.radaway), $2::INTEGER) AS radaway
FROM vault LEFT OUTER JOIN room ON room.vault_id = vault.id LEFT OUTER JOIN dweller ON dweller.vault_id = vault.id LEFT OUTER JOIN storage ON storage.vault_id = vault.id
WHERE vault.id = $3::UUID GROUP BY vault.id
