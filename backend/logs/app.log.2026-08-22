FROM vault LEFT OUTER JOIN room ON room.vault_id = vault.id LEFT OUTER JOIN dweller ON dweller.vault_id = vault.id LEFT OUTER JOIN storage ON storage.vault_id = vault.id
WHERE vault.id = $3::UUID GROUP BY vault.id
