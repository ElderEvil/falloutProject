2026-08-22 13:47:21 [INFO] [sqlalchemy.engine.Engine] [req:db71884c-35bf-4dfc-a887-d6893638b159] SELECT "user".is_deleted, "user".deleted_at, "user".created_at, "user".updated_at, "user".username, "user".email, "user".is_active, "user".is_superuser, "user".email_verified, "user".email_verification_token, "user".password_reset_token, "user".password_reset_expires, "user".id, "user".hashed_password, "user".monthly_token_limit
FROM "user"
WHERE "user".id = $1::UUID AND NOT "user".is_deleted
2026-08-22 13:47:21 [INFO] [sqlalchemy.engine.Engine] [req:db71884c-35bf-4dfc-a887-d6893638b159] [cached since 20.27s ago] (UUID('132f09ba-ce5f-44e1-8257-a52f9733e95d'),)
2026-08-22 13:47:21 [INFO] [sqlalchemy.engine.Engine] [req:db71884c-35bf-4dfc-a887-d6893638b159] SELECT vault.is_deleted, vault.deleted_at, vault.created_at, vault.updated_at, vault.number, vault.bottle_caps, vault.happiness, vault.power, vault.power_max, vault.food, vault.food_max, vault.water, vault.water_max, vault.population_max, vault.radio_mode, vault.id, vault.user_id
FROM vault
WHERE vault.id = $1::UUID AND NOT vault.is_deleted
2026-08-22 13:47:21 [INFO] [sqlalchemy.engine.Engine] [req:db71884c-35bf-4dfc-a887-d6893638b159] [cached since 20.16s ago] (UUID('f7a4d013-6252-4c19-b2ba-0bd499fe6133'),)
2026-08-22 13:47:21 [INFO] [sqlalchemy.engine.Engine] [req:db71884c-35bf-4dfc-a887-d6893638b159] SELECT vault.is_deleted, vault.deleted_at, vault.created_at, vault.updated_at, vault.number, vault.bottle_caps, vault.happiness, vault.power, vault.power_max, vault.food, vault.food_max, vault.water, vault.water_max, vault.population_max, vault.radio_mode, vault.id, vault.user_id, count(DISTINCT room.id) AS room_count, count(DISTINCT dweller.id) AS dweller_count, coalesce(max(storage.stimpack), $1::INTEGER) AS stimpack, coalesce(max(storage.radaway), $2::INTEGER) AS radaway
FROM vault LEFT OUTER JOIN room ON room.vault_id = vault.id LEFT OUTER JOIN dweller ON dweller.vault_id = vault.id LEFT OUTER JOIN storage ON storage.vault_id = vault.id
WHERE vault.id = $3::UUID GROUP BY vault.id
