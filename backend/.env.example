#============================================
# FastAPI environment variables
#============================================
SECRET_KEY=xxxxxxxxxxxxxxxx

EMAIL_TEST_USER=test@example.com
FIRST_SUPERUSER_USERNAME=xxxxx
FIRST_SUPERUSER_EMAIL=xxxxx@gmail.com
FIRST_SUPERUSER_PASSWORD=testpass123
USERS_OPEN_REGISTRATION=True

#============================================
# PostgreSQL database environment variables
#============================================
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fallout_db

#============================================
# AI Provider environment variables
#============================================
# Pydantic AI Gateway is recommended for chat and agent calls. It routes to AI_PROVIDER/AI_MODEL.
# Leave blank to use the legacy direct-provider path instead.
PYDANTIC_AI_GATEWAY_API_KEY=
# Optional: custom Gateway provider/routing-group identifier (for example, fallout-openai).
PYDANTIC_AI_GATEWAY_ROUTE=
# Set the regional Gateway proxy (for example, https://gateway-eu.pydantic.dev/proxy).
PYDANTIC_AI_GATEWAY_BASE_URL=
AI_PROVIDER=openai
AI_MODEL=gpt-4o
# Keep this key when using Gateway: image generation, TTS, and Whisper still use OpenAI's native APIs directly.
OPENAI_API_KEY=sk-1234567890abcdef1234567890abcdef
ANTHROPIC_API_KEY=
# Ollama is for local development only; use Gateway or a hosted provider in production.
OLLAMA_BASE_URL=http://localhost:11434/v1

#============================================
# Redis environment variables
#============================================
REDIS_HOST=localhost
REDIS_PORT=6379
#============================================
# Dramatiq environment variables
#============================================
# Dramatiq uses the existing REDIS_HOST and REDIS_PORT settings for task broker

#============================================
# Object Storage environment variables
#============================================
# Options: minio | rustfs

# Public URL for MinIO (used for generating public file URLs)
# Local dev: http://localhost:9000
# Production: https://media.yourdomain.com (your public subdomain)
MINIO_PUBLIC_URL=https://media.yourdomain.com

# RustFS is optional S3-compatible object storage (uses boto3). Leave its settings blank to disable media uploads;
# backend startup and core gameplay continue without it.
# Internal API endpoint (boto3 client connects here)
RUSTFS_HOSTNAME=s3-api.evillab.dev
RUSTFS_PORT=443
RUSTFS_USE_HTTPS=True
# Set real credentials in your .env — do NOT use defaults in production
RUSTFS_ACCESS_KEY=<your-access-key>
RUSTFS_SECRET_KEY=<your-secret-key>
RUSTFS_DEFAULT_BUCKET=fallout-shelter
# Public URL for generating file links
RUSTFS_PUBLIC_URL=https://s3.evillab.dev

#============================================
# Email / SMTP environment variables (Mailpit)
#============================================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=False
SMTP_SSL=False
EMAIL_FROM_ADDRESS=noreply@fallout-shelter.local
EMAIL_FROM_NAME="Fallout Shelter"
FRONTEND_URL=http://localhost:5173

#============================================
# Logging
#============================================
LOG_LEVEL=INFO
LOG_JSON_FORMAT=False
LOG_FILE_PATH=logs/app.log
LOG_FILE_RETENTION_DAYS=14

#============================================
# Security / Rate Limiting environment variables
#============================================
ENABLE_RATE_LIMITING=False
